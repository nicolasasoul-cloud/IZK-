# Copy to .env.local and fill in to enable real checkout.
# Get this from the Stripe dashboard (Developers -> API keys). Use a
# restricted/secret key, never the publishable key, and never commit it.
STRIPE_SECRET_KEY=

# Used to build Stripe's success/cancel redirect URLs. Defaults to the
# request origin if unset, so this is only needed if that's wrong
# (e.g. behind a proxy).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (About page). Get an API key at resend.com, verify a
# sending domain, then set where inquiries should land.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
